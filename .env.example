# Copy only the settings you want to override into .env.
# For a local trial, no keys are required. See docs/CONFIGURATION.md.
# Never commit .env or .env.runtime.
POSTGRES_PASSWORD=password
DASHBOARD_PORT=3000
FLAGSMITH_ADMIN_EMAIL=admin@agentbreaker.local
FLAGSMITH_ADMIN_PASSWORD=AgentBreakerDemo123!
FLAGSMITH_PUBLIC_URL=http://localhost:8000
# GENERATED SETTINGS: do not fill these manually for the bundled Flagsmith.
# scripts/bootstrap_flagsmith.py writes valid values into .env.runtime.
# These examples document names only. Do not overwrite generated values with blanks.
FLAGSMITH_API_URL=http://flagsmith:8000/api/v1/
FLAGSMITH_SERVER_KEY=
FLAGSMITH_MASTER_API_KEY=
FLAGSMITH_PROJECT_ID=0
FLAGSMITH_ENV_KEY=
FLAGSMITH_QUARANTINE_SEGMENT_ID=0
FLAGSMITH_HEALTH_WEBHOOK_URL=
# OpenAI or Ollama: full completion URL; mock is the zero-key default.
UPSTREAM_LLM_URL=http://mock-llm:8091/v1/chat/completions
UPSTREAM_LLM_API_KEY=
UPSTREAM_MCP_URL=http://mock-mcp:8090/mcp
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8085
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MAX_DOCUMENT_AGE_SECONDS=30
